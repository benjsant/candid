<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 et antérieurs (fullBackupContent). Même règle que
     data_extraction_rules.xml : aucune donnée de Candid n'est sauvegardée
     automatiquement. Voir le commentaire du manifeste. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
